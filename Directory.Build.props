<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>TugaInVegas</Authors>
    <Copyright>Copyright (c) TugaInVegas</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TugaInVegas/WinTrace</RepositoryUrl>
    <Version>0.5.0</Version>
    <!-- Debugging into the packages: symbols (.snupkg) + Source Link back to this repo. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- IntelliSense docs in the packages; not every member is documented yet. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>windows;ui-automation;trace;winappdriver;appium;novawindows;testing</PackageTags>
    <PackageProjectUrl>https://github.com/TugaInVegas/WinTrace</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    <!-- Lets coding agents find usage instructions inside the restored package. -->
    <None Include="$(MSBuildThisFileDirectory)llms.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
